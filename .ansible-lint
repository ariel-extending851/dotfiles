---
# ==============================================================================
# .ansible-lint - Ansible Lint Configuration
# Tailored for Workstation Automation and SRE Standards
# ==============================================================================
profile: production

exclude_paths:
  - scripts/legacy/
  - .github/
  - tests/

skip_list:
  - experimental
  - command-instead-of-module # Required for specific OSTree, Mokutil, and DevPod CLI calls
