# ==============================================================================
# 99-devops-performance.conf - Managed by Ansible (setup_pc.yml)
# Optimized for DevPod, Containers, and Fast Local Development
# ==============================================================================

# --- DevPod & File Watchers Tuning ---
# Prevents "ENOSPC: System limit for number of file watchers reached"
fs.inotify.max_user_watches = 1048576
fs.inotify.max_user_instances = 1024
fs.file-max = 2097152

# --- Memory & VFS Responsiveness ---
# Low swappiness prevents eviction of active terminals/IDEs under RAM pressure
vm.swappiness = 10
# Retaining dentry and inode caches speeds up git status, eza, and file traversals
vm.vfs_cache_pressure = 50
# Required for memory-mapped I/O in databases, local observability, and runtimes
vm.max_map_count = 1048576

# --- Container & K8s Networking ---
# Essential for container routing, local bridge networks, and DevPod connectivity
net.ipv4.ip_forward = 1
# Socket backlog and TCP handshake acceleration for local microservices
net.core.somaxconn = 32768
net.ipv4.tcp_max_syn_backlog = 16384
net.ipv4.tcp_fastopen = 3
