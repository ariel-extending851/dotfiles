# ==============================================================================
# 99-devops-performance.conf - Managed by system_tuning Ansible Role
# Optimized for DevPod, Containers, and High-Performance Development
# ==============================================================================

# --- DevPod & File Watchers Tuning ---
fs.inotify.max_user_watches = {{ system_tuning_inotify_max_user_watches }}
fs.inotify.max_user_instances = {{ system_tuning_inotify_max_user_instances }}
fs.file-max = {{ system_tuning_file_max }}

# --- Memory & VFS Responsiveness ---
vm.swappiness = {{ system_tuning_vm_swappiness }}
vm.vfs_cache_pressure = {{ system_tuning_vm_vfs_cache_pressure }}
vm.max_map_count = {{ system_tuning_vm_max_map_count }}

# --- Container & K8s Networking ---
net.ipv4.ip_forward = {{ system_tuning_net_ip_forward }}
net.core.somaxconn = {{ system_tuning_net_somaxconn }}
net.ipv4.tcp_max_syn_backlog = {{ system_tuning_net_tcp_max_syn_backlog }}
net.ipv4.tcp_fastopen = {{ system_tuning_net_tcp_fastopen }}
