# ==============================================================================
# 99-dns-security.conf - Managed by system_tuning Ansible Role
# Hardening for systemd-resolved (Anti-LLMNR Poisoning, DoT & DNSSEC)
# ==============================================================================

[Resolve]
DNS=192.168.8.3
FallbackDNS=1.1.1.1 9.9.9.9
Domains=~.
LLMNR=no
MulticastDNS=resolve
DNSSEC=no
DNSOverTLS=opportunistic

