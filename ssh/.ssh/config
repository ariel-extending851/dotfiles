# ==============================================================================
# ~/.ssh/config - Managed by GNU Stow (ssh package)
# SSH Client Hardening for Workstations & DevOps
# ==============================================================================

# Global Hardened Defaults for All Hosts
Host *
    # Modern authenticated ciphers only (ChaCha20 & AES-GCM)
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com

    # Elliptic-curve key exchange algorithms (Curve25519)
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512

    # Encrypt-then-MAC (EtM) message authentication codes
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

    # Host key algorithms priority
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

    # Security: Never forward SSH Agent by default (prevents remote socket hijacking)
    ForwardAgent no

    # Security: Disable X11 forwarding
    ForwardX11 no
    ForwardX11Trusted no

    # Obfuscate hostnames in ~/.ssh/known_hosts to protect against offline enumeration
    HashKnownHosts yes

    # Prompt for unknown host keys
    StrictHostKeyChecking ask

    # Only send identities explicitly offered or added to ssh-agent
    IdentitiesOnly yes

    # Keepalive to avoid silent connection drops
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Fast connection multiplexing (ControlMaster)
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 10m

# GitHub (Optimized for Git over SSH)
Host github.com
    HostName github.com
    User git
    ControlMaster no
    ForwardAgent no
